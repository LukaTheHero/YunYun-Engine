      {
        "id": "megumin-main",
        "presetId": "megumin-suite-preset",
        "identifier": "megumin-main",
        "name": "Main Prompt",
        "content": "{{megumin_prompt1}} {{megumin_main}} {{megumin_prompt2}}\n{{megumin_pronouns}}\n{{megumin_control}}\n{{megumin_ooc}}\n\n{{megumin_prompt3}}",
        "role": "system",
